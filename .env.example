# Postgres connection string
DATABASE_URL=postgres://lt:lt@localhost:5432/launch_tracker
# Set to 1 when the database requires SSL (most hosted Postgres)
PGSSL=
# Comma-separated Elysium RPCs (default: https://rpc.elysium.kinetiq.xyz)
ELYSIUM_RPCS=
# Optional CoinGecko demo key for HYPE/USD
COINGECKO_API_KEY=
PORT=3000
